# Mon Edupreneur 2.0 — environment variables.
#
# LOCAL DEVELOPMENT: you do not fill this in by hand. `make setup` (or
# `make db-reset`) writes a git-ignored `.env` with real values for the local
# stack, including a randomly generated database password.
#
# HOSTED ENVIRONMENTS (later): set the EDU_* variables in the platform's secret
# manager. Never commit real values. The LOCAL_* variables must NOT exist there.

# --- read by the API (services/api) -------------------------------------------
EDU_ENVIRONMENT=local
# Must log in as edu_api_login (member of edu_api). Never postgres/service_role.
EDU_DATABASE_URL=postgresql+asyncpg://edu_api_login:<generated-password>@127.0.0.1:54322/postgres
EDU_AUTH_ISSUER=http://127.0.0.1:54321/auth/v1
EDU_AUTH_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
EDU_AUTH_AUDIENCE=authenticated
EDU_AUTH_ALGORITHMS=["ES256"]
# Optional tuning (defaults shown)
# EDU_DB_POOL_SIZE=5
# EDU_DB_DISABLE_STATEMENT_CACHE=false   # set true behind a transaction-mode pooler
# EDU_SYNC_MAX_OPS=50
# EDU_MAX_WIRE_BODY_BYTES=20480
# EDU_MAX_DECODED_BODY_BYTES=131072

# --- read ONLY by local tooling and tests (scripts/, tests/) -------------------
LOCAL_API_DB_PASSWORD=<generated>
LOCAL_SUPABASE_URL=http://127.0.0.1:54321
LOCAL_SUPABASE_PUBLISHABLE_KEY=<from `supabase status`>
LOCAL_SUPABASE_SECRET_KEY=<from `supabase status`>
LOCAL_SUPABASE_ANON_JWT=<from `supabase status`>
LOCAL_SUPABASE_SERVICE_ROLE_JWT=<from `supabase status`>
LOCAL_ADMIN_DATABASE_URL=<from `supabase status`>
