  "revisions": {
    "fr": {
      "revision_id": "9d94b09e-9650-5ac7-a33b-53fd9447dccd",
      "revision": 1,
      "title": "Calculer un pourcentage",
      "blocks": [
        {
          "key": "sens-titre",
          "type": "heading",
          "text": "Que veut dire « pour cent » ?"
        },
        {
          "key": "sens",
          "type": "paragraph",
          "text": "Un pourcentage est une fraction dont le dénominateur est 100. 25 % veut dire 25 sur 100, c'est-à-dire 25/100."
        },
        {
          "key": "calcul-titre",
          "type": "heading",
          "text": "Calculer le pourcentage d'une quantité"
        },
        {
          "key": "calcul",
          "type": "paragraph",
          "text": "Pour calculer un pourcentage d'une quantité, on multiplie la quantité par le pourcentage, puis on divise par 100."
        },
        {
          "key": "exemple-calcul",
          "type": "example",
          "title": "Calculer 20 % de 150 gourdes",
          "steps": [
            "On multiplie : 150 × 20 = 3000.",
            "On divise par 100 : 3000 ÷ 100 = 30.",
            "20 % de 150 gourdes, c'est 30 gourdes."
          ]
        },
        {
          "key": "reduction-titre",
          "type": "heading",
          "text": "Appliquer une réduction"
        },
        {
          "key": "reduction",
          "type": "paragraph",
          "text": "Pour trouver un prix après une réduction, on calcule d'abord le montant de la réduction, puis on le soustrait du prix de départ."
        },
        {
          "key": "exemple-reduction",
          "type": "example",
          "title": "Un cahier coûte 200 gourdes, avec 10 % de réduction",
          "steps": [
            "Réduction : 200 × 10 ÷ 100 = 20 gourdes.",
            "Nouveau prix : 200 − 20 = 180 gourdes."
          ]
        },
        {
          "key": "astuce",
          "type": "callout",
          "tone": "tip",
          "text": "Astuce : 50 % d'une quantité, c'est sa moitié ; 10 %, c'est la quantité divisée par 10."
        }
      ],
      "questions": [
        {
          "question_key": "q-calcul",
          "kind": "mcq",
          "prompt": {
            "text": "Combien font 25 % de 80 ?"
          },
          "response_spec": {
            "choices": [
              {
                "id": "a",
                "text": "20"
              },
              {
                "id": "b",
                "text": "25"
              },
              {
                "id": "c",
                "text": "55"
              }
            ]
          },
          "answer_key": {
            "correct_choice_id": "a"
          },
          "explanation": {
            "text": "On multiplie 80 × 25 = 2000, puis on divise par 100 : 2000 ÷ 100 = 20."
          }
        },
        {
          "question_key": "q-reduction",
          "kind": "mcq",
          "prompt": {
            "text": "Un sac coûte 500 gourdes. Avec 20 % de réduction, quel est le nouveau prix ?"
          },
          "response_spec": {
            "choices": [
              {
                "id": "a",
                "text": "480 gourdes"
              },
              {
                "id": "b",
                "text": "400 gourdes"
              },
              {
                "id": "c",
                "text": "100 gourdes"
              }
            ]
          },
          "answer_key": {
            "correct_choice_id": "b"
          },
          "explanation": {
            "text": "La réduction est 500 × 20 ÷ 100 = 100 gourdes. Le nouveau prix est 500 − 100 = 400 gourdes."
          }
        }
      ]
    },
    "ht": {
