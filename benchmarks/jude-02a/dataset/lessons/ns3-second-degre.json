      "title": "Ekwasyon dezyèm degre",
      "blocks": [
        {
          "key": "forme-titre",
          "type": "heading",
          "text": "Fòm ekwasyon an"
        },
        {
          "key": "forme",
          "type": "paragraph",
          "text": "Yon ekwasyon dezyèm degre ekri ax² + bx + c = 0, ak a ki diferan de zewo."
        },
        {
          "key": "discriminant-titre",
          "type": "heading",
          "text": "Diskriminan an"
        },
        {
          "key": "discriminant",
          "type": "paragraph",
          "text": "Yo note diskriminan an Δ epi yo kalkile l ak fòmil Δ = b² − 4ac. Siy li montre konbyen solisyon ki genyen."
        },
        {
          "key": "cas",
          "type": "callout",
          "tone": "remember",
          "text": "Si Δ pozitif, gen de solisyon. Si Δ egal zewo, gen yon sèl solisyon. Si Δ negatif, pa gen solisyon reyèl."
        },
        {
          "key": "formule",
          "type": "paragraph",
          "text": "Lè Δ pozitif, solisyon yo se x = (−b − √Δ) / (2a) ak x = (−b + √Δ) / (2a)."
        },
        {
          "key": "exemple-resolution",
          "type": "example",
          "title": "Rezoud x² − 5x + 6 = 0",
          "steps": [
            "La a, a = 1, b = −5 epi c = 6.",
            "Δ = (−5)² − 4 × 1 × 6 = 25 − 24 = 1.",
            "Δ pozitif: gen de solisyon.",
            "x = (5 − 1) / 2 = 2 ak x = (5 + 1) / 2 = 3."
          ]
        },
        {
          "key": "verification",
          "type": "callout",
          "tone": "tip",
          "text": "Verifye chak solisyon: ranplase l nan ekwasyon depa a."
        }
      ],
