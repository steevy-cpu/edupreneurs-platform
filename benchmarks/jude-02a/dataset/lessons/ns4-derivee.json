                "text": "4x⁴"
              }
            ]
          },
          "answer_key": {
            "correct_choice_id": "a"
          },
          "explanation": {
            "text": "On descend l'exposant 4 devant et on diminue l'exposant de 1 : 4x³."
          }
        },
        {
          "question_key": "q-polynome",
          "kind": "mcq",
          "prompt": {
            "text": "Quelle est la dérivée de f(x) = 3x² + 2x + 7 ?"
          },
          "response_spec": {
            "choices": [
              {
                "id": "a",
                "text": "6x + 2"
              },
              {
                "id": "b",
                "text": "6x + 9"
              },
              {
                "id": "c",
                "text": "3x + 2"
              }
            ]
