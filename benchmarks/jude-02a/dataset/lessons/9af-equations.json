  "revisions": {
    "fr": {
      "revision_id": "d803f39f-10f8-549e-b113-c45e56b32dec",
      "revision": 1,
      "title": "Les équations du premier degré",
      "blocks": [
        {
          "key": "definition-titre",
          "type": "heading",
          "text": "Qu'est-ce qu'une équation ?"
        },
        {
          "key": "definition",
          "type": "paragraph",
          "text": "Une équation est une égalité qui contient une quantité inconnue, appelée l'inconnue. On la note souvent x. Résoudre une équation, c'est trouver la valeur de x qui rend l'égalité vraie."
        },
        {
          "key": "balance-titre",
          "type": "heading",
          "text": "Le principe de la balance"
        },
        {
          "key": "balance",
          "type": "paragraph",
          "text": "Une équation est comme une balance en équilibre. Si l'on retire la même quantité des deux côtés, la balance reste en équilibre. C'est pourquoi on peut soustraire le même nombre des deux côtés d'une équation sans changer sa solution."
        },
        {
          "key": "regle",
          "type": "callout",
          "tone": "remember",
          "text": "Tout ce que tu fais d'un côté de l'équation, tu dois le faire aussi de l'autre côté."
        },
        {
          "key": "exemple-addition",
          "type": "example",
          "title": "Résoudre x + 5 = 12",
          "steps": [
            "On veut que x reste seul du côté gauche.",
            "On soustrait 5 des deux côtés : x + 5 − 5 = 12 − 5.",
            "On obtient x = 7.",
            "Vérification : 7 + 5 = 12. L'égalité est vraie."
          ]
        },
        {
          "key": "multiplication-titre",
          "type": "heading",
          "text": "Quand l'inconnue est multipliée"
        },
        {
          "key": "multiplication",
          "type": "paragraph",
          "text": "Si l'inconnue est multipliée par un nombre, on divise les deux côtés par ce même nombre. Par exemple, dans 3x = 12, on divise les deux côtés par 3."
        },
        {
          "key": "exemple-deux-etapes",
          "type": "example",
          "title": "Résoudre 2x + 3 = 11",
          "steps": [
            "On soustrait 3 des deux côtés : 2x = 8.",
            "On divise les deux côtés par 2 : x = 4.",
            "Vérification : 2 × 4 + 3 = 11."
          ]
        },
        {
          "key": "attention-zero",
          "type": "callout",
          "tone": "warning",
          "text": "Attention : on ne divise jamais par zéro."
        },
        {
          "key": "astuce-verification",
          "type": "callout",
          "tone": "tip",
          "text": "Vérifie toujours ta réponse : remplace x par la valeur trouvée et regarde si l'égalité est vraie."
        }
      ],
      "questions": [
        {
          "question_key": "q-addition",
