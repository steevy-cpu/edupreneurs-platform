# Jude-02A — settings for Runpod's serverless vLLM worker (runpod-workers/worker-vllm).
# EXAMPLE ONLY. Copy the NAMES into the Runpod endpoint's environment settings; put
# secret VALUES in Runpod Secrets. Never commit a real token.
#
# Variable names read from the worker's README on 2026-11-26 (release v2.32.1). Its
# default vLLM build was older than vLLM's latest stable release at that date, so check
# which version the image you deploy actually contains.

MODEL_NAME=mistralai/Ministral-3-14B-Instruct-2512
OPENAI_SERVED_MODEL_NAME_OVERRIDE=jude-candidate
MAX_MODEL_LEN=4096
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=32
# Requests one worker accepts at once before Runpod queues or scales:
MAX_CONCURRENCY=16
# Where the model is cached, so a cold start does not download it again:
BASE_PATH=/runpod-volume
# Only if the model is gated. Use a Runpod Secret; do not write the value here.
# HF_TOKEN={{ RUNPOD_SECRET_hf_token }}
