{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "time": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "commit",
        "time"
      ],
      "additionalProperties": false
    },
    "transform": {
      "const": "content-migration-01.1"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": 1
          },
          "transform": {
            "const": "content-migration-01.1"
          },
          "source_table": {
            "enum": [
              "subjects",
              "lessons",
              "lesson_versions",
              "official_exams",
              "exam_exercises",
              "lesson_videos",
              "ebooks",
              "storage.objects"
            ]
          },
          "legacy_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "native_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "revision": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "locale": {
            "enum": [
              null,
              "fr",
              "ht"
            ]
          },
          "hierarchy": {
            "type": "object",
            "properties": {
              "grade": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "series": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "subject_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "unit_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "parent_id": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "grade",
              "series",
              "subject_id",
              "unit_id",
              "parent_id"
            ],
            "additionalProperties": false
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "target_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "mime": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "bytes": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "sha256": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "verified": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "mime",
                "bytes",
                "sha256",
                "verified"
              ],
              "additionalProperties": false
            }
          },
          "provenance": {
            "type": "object",
            "properties": {
              "rights_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_ref": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_status": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "rights_ref",
              "source_ref",
              "source_status"
            ],
            "additionalProperties": false
          },
          "review": {
            "const": "draft_unreviewed"
          },
          "published": {
            "const": false
          },
          "issues": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "revision_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "exam_mode": {
            "enum": [
              null,
              "human_marked_or_self_review",
              "pdf_only_or_insufficient",
              "quarantined",
              "verified_auto_gradable"
            ]
          },
          "practice_items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "position": {
                  "type": "integer",
                  "minimum": 1
                },
                "revision_item_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                },
                "question_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "position",
                "revision_item_id",
                "question_sha256"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "schema_version",
          "transform",
          "source_table",
          "legacy_id",
          "native_id",
          "revision",
          "locale",
          "hierarchy",
          "source_sha256",
          "content_sha256",
          "target_sha256",
          "assets",
          "provenance",
          "review",
          "published",
          "issues",
          "revision_id",
          "exam_mode",
          "practice_items"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "issues": {
                  "minItems": 1
                }
              }
            },
            "then": {
              "properties": {
                "target_sha256": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "target_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "snapshot",
    "transform",
    "entries"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private migration manifest, v1"
}
