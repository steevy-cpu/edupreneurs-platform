{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.mon-edupreneur.local/content-pilot/verification.schema.json",
  "title": "Mathematical verification record of one pilot lesson (authoring metadata, NOT delivered to the app)",
  "type": "object",
  "additionalProperties": false,
  "required": ["questions", "examples"],
  "properties": {
    "questions": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 20,
      "propertyNames": {"pattern": "^[a-z0-9-]{3,64}$"},
      "additionalProperties": {"oneOf": [{"$ref": "#/$defs/valueQuestion"}, {"$ref": "#/$defs/truthQuestion"}]}
    },
    "examples": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"$ref": "#/$defs/example"}}
  },
  "$defs": {
    "expr": {"type": "string", "minLength": 1, "maxLength": 400},
    "choiceId": {"pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "promptNumbers": {"type": "array", "maxItems": 12, "items": {"type": "integer", "minimum": 0}},
    "valueQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "compute", "prompt_numbers", "choices"],
      "properties": {
        "mode": {"const": "value"},
        "compute": {"$ref": "#/$defs/expr"},
        "prompt_numbers": {"$ref": "#/$defs/promptNumbers"},
        "prompt_math": {"type": "string", "minLength": 3, "maxLength": 120},
        "operands_in_proof": {"type": "boolean"},
        "choices": {"type": "object", "minProperties": 2, "maxProperties": 6, "propertyNames": {"$ref": "#/$defs/choiceId"}, "additionalProperties": {"type": "integer"}}
      }
    },
    "truthQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "prompt_numbers", "choices"],
      "properties": {
        "mode": {"const": "truth"},
        "prompt_numbers": {"$ref": "#/$defs/promptNumbers"},
        "prompt_math": {"type": "string", "minLength": 3, "maxLength": 120},
        "operands_in_proof": {"type": "boolean"},
        "choices": {"type": "object", "minProperties": 2, "maxProperties": 6, "propertyNames": {"$ref": "#/$defs/choiceId"}, "additionalProperties": {"$ref": "#/$defs/truthChoice"}}
      }
    },
    "truthChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expr", "numbers", "symbols"],
      "properties": {
        "expr": {"$ref": "#/$defs/expr"},
        "numbers": {"type": "array", "maxItems": 12, "items": {"type": "integer", "minimum": 0}},
        "symbols": {"type": "string", "maxLength": 12, "pattern": "^[+−×÷=<>≤≥≠]*$"}
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["block", "checks"],
      "properties": {
        "block": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["expr", "equals", "must_appear"],
            "properties": {
              "expr": {"$ref": "#/$defs/expr"},
              "equals": {"oneOf": [{"type": "integer"}, {"type": "boolean"}, {"type": "array", "maxItems": 100, "items": {"type": "integer"}}]},
              "must_appear": {"type": "string", "minLength": 1, "maxLength": 200}
            }
          }
        }
      }
    }
  }
}
