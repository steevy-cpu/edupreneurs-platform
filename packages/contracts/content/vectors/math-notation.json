{
  "vector_format": 1,
  "suite": "math-notation",
  "description": "Sources of 'math' blocks in the notation edu-math-1. expect is {valid:true}, {valid:false, layer:'schema'} (rejected by the character-set / length pattern of lesson-blocks.v2.schema.json) or {valid:false, layer:'semantic', rule:'math.*'} (the FIRST grammar error found scanning left to right). To test a full validator, wrap each source in [{key:'m', type:'math', notation:'edu-math-1', source:<source>, alt:'x'}].",
  "cases": [
    {
      "id": "ok-linear",
      "source": "x + 3 = 10",
      "expect": {
        "valid": true
      }
    },
    {
      "id": "ok-fraction",
      "source": "\\frac{a}{b}",
      "expect": {
        "valid": true
      }
    },
    {
      "id": "ok-pythagoras",
      "source": "x^2 + y^2 = r^2",
      "expect": {
        "valid": true
      }
    },
    {
      "id": "ok-root",
      "source": "\\sqrt{x + 1}",
      "expect": {
        "valid": true
      }
    },
    {
      "id": "ok-cube-root",
      "source": "\\sqrt[3]{27} = 3",
      "expect": {
        "valid": true
      }
    },
    {
      "id": "ok-subscripts",
      "source": "x_1 + x_2",
      "expect": {
        "valid": true
      }
    },
    {
      "id": "ok-sub-and-super",
      "source": "x_1^2 + a_{i}^{2}",
      "expect": {
        "valid": true
      }
    },
    {
      "id": "ok-super-then-sub",
      "source": "x^2_1",
      "expect": {
        "valid": true
      }
    },
    {
      "id": "ok-group-exponent",
      "source": "x^{n+1}",
      "expect": {
        "valid": true
      }
    },
    {
      "id": "ok-times",
      "source": "2 \\times 3 = 6",
      "expect": {
        "valid": true
      }
    },
    {
      "id": "ok-circle-area",
      "source": "A = \\pi r^{2}",
      "expect": {
        "valid": true
      }
    },
    {
      "id": "ok-quadratic",
      "source": "x = \\frac{-b \\pm \\sqrt{b^2 - 4ac}}{2a}",
      "expect": {
        "valid": true
      }
    },
    {
      "id": "ok-number-set",
      "source": "x \\in \\mathbb{R}",
      "expect": {
        "valid": true
      }
    },
    {
      "id": "ok-text-with-accents",
      "source": "\\text{aire} = \\text{côté} \\times \\text{côté}",
      "expect": {
        "valid": true
      }
    },
    {
      "id": "ok-text-with-punctuation",
      "source": "\\text{si x > 0, alors l'aire est positive.}",
      "expect": {
        "valid": true
      }
    },
    {
      "id": "ok-set-braces",
      "source": "\\{1, 2, 3\\}",
      "expect": {
        "valid": true
      }
    },
    {
      "id": "ok-percent",
      "source": "50\\%",
      "expect": {
        "valid": true
      }
    },
    {
      "id": "ok-absolute-value",
      "source": "|x| \\ge 0",
      "expect": {
        "valid": true
      }
    },
    {
      "id": "ok-segment",
      "source": "\\overline{AB} = 5",
      "expect": {
        "valid": true
      }
    },
    {
      "id": "ok-vector",
