{
  "vector_format": 1,
  "suite": "plain-text",
  "description": "The plain-text rule of every NEW format-2 text field (review M4): no C0 control and no DEL, no '<' directly followed by a letter, '/', '!' or '?', and no invisible or direction-changing character - C1 controls U+0080-U+009F, U+200B-U+200F, U+2028-U+202E, U+2060, U+2066-U+2069, U+FEFF, lone surrogates. For every case, put 'text' in place of the string \"@TEXT@\" in EACH document of 'targets' and validate it (lesson bodies as content format 2; questions with their 'kind'); the result must be 'expect' for every target. The four format-1 block types (heading, paragraph, example, callout) and 'mcq' questions are deliberately NOT covered: they stay exactly as in format 1 (owner decision). The same rule applies to a lesson title in a pack. Written with ASCII-only JSON escapes; lone surrogates appear as single \\ud800-style escapes.",
  "targets": [
    {
      "id": "image-alt",
      "schema": "lesson-blocks.v2.schema.json",
      "document": [
        {
          "key": "i",
          "type": "image",
          "asset": {
            "sha256": "abababababababababababababababababababababababababababababababab",
            "mime": "image/png",
            "bytes": 100,
            "width": 16,
            "height": 9
          },
          "alt": "@TEXT@"
        }
      ]
    },
    {
      "id": "image-caption",
      "schema": "lesson-blocks.v2.schema.json",
      "document": [
        {
          "key": "i",
          "type": "image",
          "asset": {
            "sha256": "abababababababababababababababababababababababababababababababab",
            "mime": "image/png",
            "bytes": 100,
            "width": 16,
            "height": 9
          },
          "alt": "x",
          "caption": "@TEXT@"
        }
      ]
    },
    {
      "id": "math-alt",
      "schema": "lesson-blocks.v2.schema.json",
      "document": [
        {
          "key": "m",
          "type": "math",
          "notation": "edu-math-1",
          "source": "x",
          "alt": "@TEXT@"
        }
      ]
    },
    {
      "id": "list-item",
      "schema": "lesson-blocks.v2.schema.json",
      "document": [
        {
          "key": "l",
          "type": "list",
          "style": "bullet",
          "items": [
            "un",
            "@TEXT@"
          ]
        }
      ]
    },
    {
      "id": "table-caption",
      "schema": "lesson-blocks.v2.schema.json",
      "document": [
        {
          "key": "t",
          "type": "table",
          "caption": "@TEXT@",
          "columns": [
            "a",
            "b"
          ],
          "rows": [
            [
              "1",
              "2"
            ]
          ]
        }
      ]
    },
    {
      "id": "table-column",
      "schema": "lesson-blocks.v2.schema.json",
      "document": [
        {
          "key": "t",
          "type": "table",
          "caption": "c",
          "columns": [
            "@TEXT@",
            "b"
          ],
          "rows": [
            [
              "1",
              "2"
            ]
          ]
        }
      ]
    },
    {
      "id": "table-cell",
      "schema": "lesson-blocks.v2.schema.json",
      "document": [
        {
          "key": "t",
          "type": "table",
          "caption": "c",
          "columns": [
            "a",
            "b"
          ],
          "rows": [
            [
              "1",
              "@TEXT@"
            ]
          ]
        }
      ]
    },
    {
      "id": "audio-title",
      "schema": "lesson-blocks.v2.schema.json",
      "document": [
        {
          "key": "p",
          "type": "paragraph",
          "text": "x"
        },
        {
          "key": "a",
          "type": "audio",
          "asset": {
            "sha256": "abababababababababababababababababababababababababababababababab",
            "mime": "audio/mp4",
            "bytes": 100
          },
          "duration_ms": 1000,
          "title": "@TEXT@",
          "transcript": {
            "block_keys": [
              "p"
            ]
          }
        }
      ]
    },
    {
      "id": "numeric-unit",
      "schema": "question-numeric.schema.json",
      "kind": "numeric",
      "document": {
        "prompt": {
          "text": "?"
        },
        "response_spec": {
          "allow_fraction": false,
          "unit": "@TEXT@"
        },
        "answer_key": {
          "scoring_version": "numeric-v1",
          "value": "1",
          "tolerance": "0"
        },
        "explanation": {
          "text": "."
        }
      }
    },
    {
      "id": "short-text-accepted",
      "schema": "question-short-text.schema.json",
      "kind": "short_text",
      "document": {
        "prompt": {
          "text": "?"
        },
        "response_spec": {
          "max_length": 80,
          "case_sensitive": false,
          "accent_sensitive": false
        },
        "answer_key": {
          "scoring_version": "short-text-v1",
          "accepted": [
            "@TEXT@"
          ]
        },
        "explanation": {
          "text": "."
        }
      }
    }
  ],
  "cases": [
