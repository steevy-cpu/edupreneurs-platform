{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.mon-edupreneur.local/content/lesson-blocks.schema.json",
  "title": "Lesson blocks (content format v1)",
  "description": "Value of app.lesson_revisions.blocks. A lesson is an ordered list of small typed blocks, never free HTML, so old phones can render it cheaply and reviewers can check it piece by piece.",
  "type": "array",
  "minItems": 1,
  "maxItems": 200,
  "items": { "$ref": "#/$defs/block" },
  "$defs": {
    "key": {
      "description": "Stable identifier of the block inside this revision (used for reading position).",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "block": {
      "oneOf": [
        { "$ref": "#/$defs/heading" },
        { "$ref": "#/$defs/paragraph" },
        { "$ref": "#/$defs/example" },
        { "$ref": "#/$defs/callout" }
      ]
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "text"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "type": { "const": "heading" },
        "text": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "text"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "type": { "const": "paragraph" },
        "text": { "$ref": "#/$defs/text" }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "steps"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "type": { "const": "example" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "callout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "tone", "text"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "type": { "const": "callout" },
        "tone": { "enum": ["tip", "warning", "remember"] },
        "text": { "$ref": "#/$defs/text" }
      }
    }
  }
}
