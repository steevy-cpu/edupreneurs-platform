{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.mon-edupreneur.local/content/question-numeric.schema.json",
  "title": "Numeric practice question (content format v2)",
  "description": "The four JSON columns of a question whose kind is 'numeric'. Scoring rule 'numeric-v1' (README.md, section 'numeric-v1'): the learner's text is normalised (spaces removed, U+2212 to '-', decimal comma to point), parsed EXACTLY as a decimal or, when response_spec.allow_fraction is true, as a fraction a/b; score 1 when |response - answer_key.value| <= answer_key.tolerance (inclusive, exact arithmetic, never binary floating point), otherwise 0. Text that is not a number under the rule is not scored ('invalid_response', code 'not_a_number'). CONTRACT ONLY: the server's sync function does not score this kind yet.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "prompt",
    "response_spec",
    "answer_key",
    "explanation"
  ],
  "properties": {
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "response_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_fraction"
      ],
      "properties": {
        "allow_fraction": {
          "type": "boolean"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16,
          "allOf": [
            {
              "$ref": "#/$defs/noControl"
            },
            {
              "$ref": "#/$defs/noMarkup"
            }
          ],
          "description": "Display-only unit label shown next to the input, e.g. 'cm'. Never part of the answer."
        }
      }
    },
    "answer_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scoring_version",
        "value",
        "tolerance"
      ],
      "properties": {
        "scoring_version": {
          "const": "numeric-v1"
        },
        "value": {
          "$ref": "#/$defs/decimal"
        },
        "tolerance": {
          "description": "Absolute tolerance, >= 0. '0' means exact.",
          "$ref": "#/$defs/nonNegativeDecimal"
        }
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  },
  "$defs": {
    "noControl": {
      "not": {
        "pattern": "[\\u0000-\\u001f\\u007f]"
      }
    },
    "noMarkup": {
      "not": {
        "pattern": "<[A-Za-z/!?]"
      }
    },
    "decimal": {
      "description": "Canonical decimal string: optional '-', up to 12 integer digits without leading zeros, optionally '.' and 1 to 6 fraction digits.",
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,11})(\\.[0-9]{1,6})?$",
      "maxLength": 20,
      "$ref": "#/$defs/noControl"
    },
    "nonNegativeDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,6})?$",
      "maxLength": 19,
      "$ref": "#/$defs/noControl"
    },
    "response": {
      "description": "What the phone sends as the learner's answer: the text exactly as typed (at most 32 code points). The phone does not parse it into a number before sending.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      }
    }
  }
}
