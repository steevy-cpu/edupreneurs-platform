{
  "name": "mon-edupreneur-student-native",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "jest": "~30.5.2",
    "@types/jest": "30.0.0",
    "babel-jest": "~30.5.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "gen:api": "npx --yes openapi-typescript@7.13.0 ../../packages/contracts/openapi.json -o src/core/api/schema.d.ts",
    "check:api": "npx --yes openapi-typescript@7.13.0 ../../packages/contracts/openapi.json -o src/core/api/schema.d.ts --check",
    "bundle:check": "expo export --platform android --platform ios --output-dir dist"
  },
  "private": true
}
